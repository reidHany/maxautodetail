{
  "name": "maxautodetail",
  "private": true,
  "version": "0.1.0",
  "description": "Auto detailing website built with React, Vite, and a backend stub",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "test": "npm run build:server && node --test server-tests/*.test.cjs",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.4",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vite": "^8.2.1"
  }
}
