# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_Your API Key Here

# Must use a domain verified in Resend, for example:
# SENDER_EMAIL=Stanbrough Sparkle <bookings@yourdomain.com>
# For initial testing, use onboarding@resend.dev. It can only send to the
# address associated with your Resend account until you verify your own domain.
SENDER_EMAIL=onboarding@resend.dev

# Receives internal notifications about new bookings.
BUSINESS_EMAIL=reid.hany@gmail.com

# Optional SQLite location. Use a persistent disk path in production.
# DATABASE_PATH=C:/path/to/persistent/bookings.sqlite

# Comma-separated browser origins allowed to call the production API.
ALLOWED_ORIGINS=https://yourdomain.com
BUSINESS_TIME_ZONE=America/Chicago

# Change this before deploying.
ADMIN_PASSWORD=replaceThisWithAStrongPassword
